FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -buildvcs=false -ldflags='-s -w' -o /tmp/validation-controller ./cmd/validation-controller

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.6

COPY --from=builder /tmp/validation-controller /validation-controller
USER 65532:65532
ENTRYPOINT ["/validation-controller"]
